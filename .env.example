# Copy to .env and fill in real values. Generate LITELLM_SALT_KEY with:
# openssl rand -hex 32. The AWS credentials must have bedrock:InvokeModel
# and bedrock:InvokeModelWithResponseStream permission on the inference
# profile ARN used in config.yaml.

LITELLM_MASTER_KEY=sk-CHANGE-ME-strong-random-value
LITELLM_SALT_KEY=CHANGE-ME-openssl-rand-hex-32
DATABASE_URL=postgresql://litellm:litellmpw@db:5432/litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellmpw
POSTGRES_DB=litellm

# AWS credentials for Bedrock
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_REGION_NAME=ap-southeast-2

# OpenAI-compatible upstream (Ollama, vLLM, Together, Groq, etc.)
OPENAI_COMPAT_MODEL=gpt-4o-mini
OPENAI_COMPAT_API_BASE=https://api.example.com/v1
OPENAI_COMPAT_API_KEY=CHANGE-ME

# pgAdmin login (UI at http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=CHANGE-ME
