# --- Gateway server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
LOG_LEVEL=INFO

# --- Auth ---
# Path to YAML file mapping gateway api keys -> allowed source IPs / CIDRs.
AUTH_CONFIG_PATH=./auth.yaml
# Set true ONLY if the gateway sits behind a trusted reverse proxy that
# forwards the original client IP via X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Prompt security ---
# Path to YAML file with prompt-security rules. If the file is missing,
# the gateway runs with no rules (logged as a warning at startup).
SECURITY_CONFIG_PATH=./security.yaml

# --- Backend LLM (OpenAI-compatible) ---
# First integration target. LiteLLM will use these to call the upstream model.
BACKEND_API_BASE=https://api.openai.com/v1
BACKEND_API_KEY=sk-replace-me
BACKEND_MODEL=gpt-4o

# --- LiteLLM ---
LITELLM_LOG=INFO
